/*==================  GOOGLE MAP  ======================*/
.map {
  position: relative;
}
.map_model {
  height: 246px;
}
.map_model img {
  max-width: none !important;
}
@media (max-width: 767px) {
  .map_model {
    height: 246px;
  }
}
@media (max-width: 479px) {
  .map_model {
    height: 200px;
  }
}
.map_locations {
  display: none;
}
.map2 .map_model {
  height: 458px;
}
